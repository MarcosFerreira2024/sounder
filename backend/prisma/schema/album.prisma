model Album {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  authorId  String   @db.Uuid
  cover     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    Artist   @relation(fields: [authorId], references: [id])
  musics    Music[]
}
