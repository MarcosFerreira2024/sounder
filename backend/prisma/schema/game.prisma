model DailyGame {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date          DateTime           @unique
  originalImage String
  blur100       String
  blur75        String
  blur50        String
  blur25        String
  audio         String
  musicName     String
  artistName    String
  correctAnswer String
  history       DailyGameHistory[]
  games         Game[]
}

model GameMode {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String           @unique
  description  String?
  games        Game[]
  userStatuses UserGameStatus[]
}

model Game {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gamemodeId  String        @db.Uuid
  dailyGameId String?       @db.Uuid
  dailyGame   DailyGame?    @relation(fields: [dailyGameId], references: [id])
  gamemode    GameMode      @relation(fields: [gamemodeId], references: [id])
  sessions    GameSession[]
}

model GameSession {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @db.Uuid
  gameId        String     @db.Uuid
  status        GameStatus @default(IN_PROGRESS)
  tries         Int        @default(0)
  correctAnswer Boolean?
  game          Game       @relation(fields: [gameId], references: [id])
  user          User       @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
}

model UserGameStatus {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  gamemodeId String   @db.Uuid
  streak     Int      @default(0)
  wins       Int      @default(0)
  matches    Int      @default(0)
  loses      Int      @default(0)
  timePlayed Int      @default(0)
  winPercent Float    @default(0)
  gamemode   GameMode @relation(fields: [gamemodeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([gamemodeId, userId])
}

model DailyGameHistory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyGameId String    @db.Uuid
  date        DateTime
  dailyGame   DailyGame @relation(fields: [dailyGameId], references: [id])
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}
